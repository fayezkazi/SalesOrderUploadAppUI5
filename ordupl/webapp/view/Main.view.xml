<mvc:View controllerName="zsd.ordupl.controller.Main"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:table="sap.ui.table">
    <Page id="page" class="orderUploadPage" title="Create Sales Orders from Your File" enableScrolling="false">
        <content>

                <!-- Top Panel: file selection and import controls -->
                <Panel id="topPanel" expandable="true" expanded="true" expand=".onTopPanelExpand" class="orderUploadTopPanel">
                    <headerToolbar>
                        <Toolbar id="_IDGenToolbar">
                            <Title id="_IDGenTitle1" text="File Import"/>
                        </Toolbar>
                    </headerToolbar>
                    <VBox id="_IDGenVBox1" class="sapUiSmallMarginTop sapUiSmallMarginBegin sapUiSmallMarginEnd">
                        <Label id="_IDGenLabel31" text="Import Name:" labelFor="importNameInput"/>
                        <HBox id="_IDGenHBox" alignItems="Center" class="sapUiTinyMarginTop">
                            <Input id="importNameInput" placeholder="Import name">
                                <layoutData>
                                    <FlexItemData id="_IDGenFlexItemData" growFactor="1"/>
                                </layoutData>
                            </Input>
                            <Button id="_IDGenButton" text="Browse..." press=".onBrowse" class="sapUiSmallMarginBegin"/>
                        </HBox>
                        <HBox id="dropZone" alignItems="Center" class="orderUploadDropZoneCompact sapUiTinyMarginTop">
                            <core:Icon id="_IDGenIcon" src="sap-icon://document" class="orderUploadDropIconSmall"/>
                            <Text id="dropZoneText" text="Select or drag an XLSX file for preview." class="orderUploadDropTextSmall sapUiSmallMarginBegin"/>
                        </HBox>
                    </VBox>
                    <OverflowToolbar id="_IDGenOverflowToolbar">
                        <ToolbarSpacer id="_IDGenToolbarSpacer"/>
                        <Button id="importBtn" text="Import" type="Emphasized" enabled="false" press=".onImport"/>
                        <Button id="_IDGenButton1" text="Cancel" press=".onCancel"/>
                    </OverflowToolbar>
                </Panel>

                <!-- Bottom VBox: fills remaining page height -->
                <VBox id="bottomVBox" class="orderUploadBottomVBox">
                    <table:Table id="resultTable"
                                 rows="{results>/items}"
                                 visibleRowCountMode="Fixed"
                                 visibleRowCount="10"
                                 selectionMode="Single"
                                 rowActionCount="1"
                                 alternateRowColors="true"
                                 class="orderUploadResultTable sapUiSizeCompact">
                        <table:rowActionTemplate>
                            <table:RowAction id="_IDGenRowAction">
                                <table:RowActionItem id="_IDGenRowActionItem" type="Navigation" press=".onNavToDetail"/>
                            </table:RowAction>
                        </table:rowActionTemplate>
                        <table:extension>
                        <OverflowToolbar id="_IDGenOverflowToolbar1">
                            <Title id="_IDGenTitle2" text="{= 'Import Results (' + ${results>/itemsCount} + ')'}"/>
                            <ToolbarSpacer id="_IDGenToolbarSpacer1"/>
                            <Button id="_IDGenButton2" text="Unprocessed" press=".onShowStagingData" type="Attention"/>
                            <Button id="_IDGenButton3" text="Processed" press=".onProcessedData" type="Success"/>
                            <Button id="downloadBtn" icon="sap-icon://download" tooltip="Download as Excel" press=".onDownloadExcel"/>
                        </OverflowToolbar>
                        </table:extension>
                        <table:footer>
                        <OverflowToolbar id="_IDGenOverflowToolbar2">
                            <Button id="_IDGenButton4" text="Cleanup Staging" press=".onDeleteStagingData" type="Reject"/>
                            <ToolbarSpacer id="_IDGenToolbarSpacer2"/>
                            <Button id="executeBtn" text="Execute" press=".onProcessRecords" type="Emphasized" enabled="{results>/hasUnprocessed}"/>
                        </OverflowToolbar>
                        </table:footer>
                        <table:columns>
                            <table:Column id="_IDGenColumn" width="24rem">
                                <Label id="_IDGenLabel32" text="Status"/>
                                <table:template>
                                    <ObjectStatus id="_IDGenObjectStatus2"
                                        state="{path: 'results>Status', formatter: '.formatter.statusState'}"
                                        icon="{path: 'results>Status', formatter: '.formatter.statusIcon'}"
                                        text="{results>StatusMsg}"/>
                                </table:template>
                            </table:Column>
                            <table:Column id="_IDGenColumnSO" width="8rem">
                                <Label id="_IDGenLabelSO" text="Sales Order"/>
                                <table:template><Text id="_IDGenTextSO" text="{results>Vbeln}" wrapping="false"/></table:template>
                            </table:Column>                            
                            <table:Column id="_IDGenColumn1" width="8rem">
                                <Label id="_IDGenLabel33" text="Order Type"/>
                                <table:template><Text id="_IDGenText1" text="{results>Auart}" wrapping="false"/></table:template>
                            </table:Column>
                            <table:Column id="_IDGenColumn2" width="8rem">
                                <Label id="_IDGenLabel34" text="Sales Org"/>
                                <table:template><Text id="_IDGenText2" text="{results>Vkorg}" wrapping="false"/></table:template>
                            </table:Column>
                            <table:Column id="_IDGenColumn3" width="9rem">
                                <Label id="_IDGenLabel35" text="Dist. Channel"/>
                                <table:template><Text id="_IDGenText3" text="{results>Vtweg}" wrapping="false"/></table:template>
                            </table:Column>
                            <table:Column id="_IDGenColumn4" width="7rem">
                                <Label id="_IDGenLabel36" text="Division"/>
                                <table:template><Text id="_IDGenText4" text="{results>Spart}" wrapping="false"/></table:template>
                            </table:Column>
                            <table:Column id="_IDGenColumn5" width="8rem">
                                <Label id="_IDGenLabel37" text="Sales Office"/>
                                <table:template><Text id="_IDGenText5" text="{results>Vkbur}" wrapping="false"/></table:template>
                            </table:Column>
                            <table:Column id="_IDGenColumn6" width="10rem">
                                <Label id="_IDGenLabel38" text="Sold-To Party"/>
                                <table:template><Text id="_IDGenText6" text="{results>KunnrAg}" wrapping="false"/></table:template>
                            </table:Column>
                            <table:Column id="_IDGenColumn7" width="10rem">
                                <Label id="_IDGenLabel39" text="Ship-To Party"/>
                                <table:template><Text id="_IDGenText7" text="{results>KunnrWe}" wrapping="false"/></table:template>
                            </table:Column>
                            <table:Column id="_IDGenColumn8" width="9rem">
                                <Label id="_IDGenLabel40" text="Order Reason"/>
                                <table:template><Text id="_IDGenText8" text="{results>Augru}" wrapping="false"/></table:template>
                            </table:Column>
                            <table:Column id="_IDGenColumn9" width="10rem">
                                <Label id="_IDGenLabel41" text="PO Number"/>
                                <table:template><Text id="_IDGenText9" text="{results>Bstnk}" wrapping="false"/></table:template>
                            </table:Column>
                            <table:Column id="_IDGenColumn10" width="8rem">
                                <Label id="_IDGenLabel42" text="PO Date"/>
                                <table:template><Text id="_IDGenText10" text="{results>Bstdk}" wrapping="false"/></table:template>
                            </table:Column>
                            <table:Column id="_IDGenColumn11" width="12rem">
                                <Label id="_IDGenLabel43" text="Req. Delivery Date"/>
                                <table:template><Text id="_IDGenText11" text="{results>Vdatu}" wrapping="false"/></table:template>
                            </table:Column>
                            <table:Column id="_IDGenColumn12" width="12rem">
                                <Label id="_IDGenLabel44" text="Name 1"/>
                                <table:template><Text id="_IDGenText12" text="{results>Name1}" wrapping="false"/></table:template>
                            </table:Column>
                            <table:Column id="_IDGenColumn13" width="12rem">
                                <Label id="_IDGenLabel45" text="Name 2"/>
                                <table:template><Text id="_IDGenText13" text="{results>Name2}" wrapping="false"/></table:template>
                            </table:Column>
                            <table:Column id="_IDGenColumn14" width="12rem">
                                <Label id="_IDGenLabel46" text="Street"/>
                                <table:template><Text id="_IDGenText14" text="{results>Stras}" wrapping="false"/></table:template>
                            </table:Column>
                            <table:Column id="_IDGenColumn15" width="12rem">
                                <Label id="_IDGenLabel47" text="Street 2"/>
                                <table:template><Text id="_IDGenText15" text="{results>StrSuppl}" wrapping="false"/></table:template>
                            </table:Column>
                            <table:Column id="_IDGenColumn16" width="10rem">
                                <Label id="_IDGenLabel48" text="City"/>
                                <table:template><Text id="_IDGenText16" text="{results>Ort01}" wrapping="false"/></table:template>
                            </table:Column>
                            <table:Column id="_IDGenColumn17" width="7rem">
                                <Label id="_IDGenLabel49" text="Region"/>
                                <table:template><Text id="_IDGenText17" text="{results>Regio}" wrapping="false"/></table:template>
                            </table:Column>
                            <table:Column id="_IDGenColumn18" width="9rem">
                                <Label id="_IDGenLabel50" text="Postal Code"/>
                                <table:template><Text id="_IDGenText18" text="{results>Pstlz}" wrapping="false"/></table:template>
                            </table:Column>
                            <table:Column id="_IDGenColumn19" width="14rem">
                                <Label id="_IDGenLabel51" text="Email Address"/>
                                <table:template><Text id="_IDGenText19" text="{results>SmtpAddr}" wrapping="false"/></table:template>
                            </table:Column>
                            <table:Column id="_IDGenColumn20" width="7rem">
                                <Label id="_IDGenLabel52" text="Item No."/>
                                <table:template><Text id="_IDGenText20" text="{results>Posnr}" wrapping="false"/></table:template>
                            </table:Column>
                            <table:Column id="_IDGenColumn21" width="10rem">
                                <Label id="_IDGenLabel53" text="Material"/>
                                <table:template><Text id="_IDGenText21" text="{results>Matnr}" wrapping="false"/></table:template>
                            </table:Column>
                            <table:Column id="_IDGenColumn22" width="8rem">
                                <Label id="_IDGenLabel54" text="Order Qty"/>
                                <table:template><Text id="_IDGenText22" text="{results>Kwmeng}" wrapping="false"/></table:template>
                            </table:Column>
                            <table:Column id="_IDGenColumn23" width="7rem">
                                <Label id="_IDGenLabel55" text="Base UOM"/>
                                <table:template><Text id="_IDGenText23" text="{results>Vrkme}" wrapping="false"/></table:template>
                            </table:Column>
                            <table:Column id="_IDGenColumn24" width="7rem">
                                <Label id="_IDGenLabel56" text="Batch"/>
                                <table:template><Text id="_IDGenText24" text="{results>Charg}" wrapping="false"/></table:template>
                            </table:Column>
                            <table:Column id="_IDGenColumn25" width="7rem">
                                <Label id="_IDGenLabel57" text="Plant"/>
                                <table:template><Text id="_IDGenText25" text="{results>Werks}" wrapping="false"/></table:template>
                            </table:Column>
                        </table:columns>
                    </table:Table>
                </VBox>

        </content>
    </Page>
</mvc:View>
